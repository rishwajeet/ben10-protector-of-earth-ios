set(PROTECTOR_IOS_CINEMATIC_PACK_MANIFEST "" CACHE FILEPATH
    "External source-bound restored cinematic pack; omitted means original video fallback")

function(protector_embed_cinematic_pack target)
    if(PROTECTOR_IOS_CINEMATIC_PACK_MANIFEST STREQUAL "")
        return()
    endif()
    if(NOT IS_ABSOLUTE "${PROTECTOR_IOS_CINEMATIC_PACK_MANIFEST}" OR
       NOT EXISTS "${PROTECTOR_IOS_CINEMATIC_PACK_MANIFEST}" OR
       IS_DIRECTORY "${PROTECTOR_IOS_CINEMATIC_PACK_MANIFEST}" OR
       IS_SYMLINK "${PROTECTOR_IOS_CINEMATIC_PACK_MANIFEST}")
        message(FATAL_ERROR "Cinematic pack requires an existing absolute regular manifest")
    endif()
    file(REAL_PATH "${CMAKE_SOURCE_DIR}" source_real)
    file(REAL_PATH "${CMAKE_BINARY_DIR}" build_real)
    file(REAL_PATH "${PROTECTOR_IOS_CINEMATIC_PACK_MANIFEST}" manifest_real)
    get_filename_component(pack_root "${manifest_real}" DIRECTORY)
    foreach(external IN ITEMS "${manifest_real}" "${build_real}")
        cmake_path(IS_PREFIX source_real "${external}" NORMALIZE inside)
        if(inside)
            message(FATAL_ERROR "Cinematic assets and their build must remain outside Git")
        endif()
    endforeach()
    file(SIZE "${manifest_real}" manifest_size)
    if(manifest_size GREATER 2097152)
        message(FATAL_ERROR "Cinematic manifest exceeds 2 MiB")
    endif()
    file(READ "${manifest_real}" manifest)
    string(JSON schema ERROR_VARIABLE schema_error GET "${manifest}" schema)
    string(JSON title ERROR_VARIABLE title_error GET "${manifest}" title_dol_sha256)
    string(JSON count ERROR_VARIABLE entries_error LENGTH "${manifest}" entries)
    if(schema_error OR title_error OR entries_error OR
       NOT schema MATCHES "^protector-native\\.cinematic-pack/v[12]$" OR
       NOT title STREQUAL "03d2d8238fbd62c611c259ebeac3b2d87c3744bbaf3fb31ffd2c28d6664ac566" OR
       count LESS 1 OR count GREATER 76)
        message(FATAL_ERROR "Cinematic pack must be a bounded source-bound RBNEG9 manifest")
    endif()
    set(payloads "")
    set(movies "")
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON relative ERROR_VARIABLE path_error GET "${manifest}" entries ${index} video)
        string(JSON movie ERROR_VARIABLE movie_error GET "${manifest}" entries ${index} movie)
        if(path_error OR movie_error OR NOT relative MATCHES "^[A-Za-z0-9_]+\\.mp4$" OR
           NOT movie MATCHES "^[A-Za-z0-9_]+\\.bik$" OR movie IN_LIST movies OR
           "${pack_root}/${relative}" IN_LIST payloads)
            message(FATAL_ERROR "Cinematic media and source names must be unique direct children")
        endif()
        if(NOT EXISTS "${pack_root}/${relative}" OR IS_DIRECTORY "${pack_root}/${relative}" OR
           IS_SYMLINK "${pack_root}/${relative}")
            message(FATAL_ERROR "Cinematic media must be a regular file inside its external pack")
        endif()
        file(REAL_PATH "${pack_root}/${relative}" payload_real)
        cmake_path(IS_PREFIX pack_root "${payload_real}" NORMALIZE inside)
        cmake_path(IS_PREFIX source_real "${payload_real}" NORMALIZE in_repo)
        if(NOT inside OR in_repo)
            message(FATAL_ERROR "Cinematic media escapes the external pack or enters Git")
        endif()
        string(JSON expected_hash ERROR_VARIABLE hash_error GET "${manifest}" entries ${index} video_sha256)
        string(JSON expected_size ERROR_VARIABLE size_error GET "${manifest}" entries ${index} video_bytes)
        file(SHA256 "${payload_real}" actual_hash)
        file(SIZE "${payload_real}" actual_size)
        if(hash_error OR size_error OR NOT actual_hash STREQUAL expected_hash OR
           NOT actual_size EQUAL expected_size OR actual_size GREATER 2147483648)
            message(FATAL_ERROR "Cinematic media differs from its declared hash or size")
        endif()
        list(APPEND payloads "${pack_root}/${relative}")
        list(APPEND movies "${movie}")
    endforeach()
    set(destination "${CMAKE_BINARY_DIR}/runtime-resources/RestoredCinematics/cinematics.json")
    configure_file("${manifest_real}" "${destination}" COPYONLY)
    set_source_files_properties("${destination}" ${payloads} PROPERTIES
        MACOSX_PACKAGE_LOCATION "Resources/RestoredCinematics")
    target_sources(${target} PRIVATE "${destination}" ${payloads})
endfunction()
